# Local runtime data — the real database/settings live in %APPDATA%\SFPoker\
# (see config/paths.py); anything under data/ here is a stale pre-migration
# copy, and config/settings.json is personal (hero name, currency, folders).
data/
config/settings.json

# Build artifacts — fully regenerable via build.bat / build_installer.bat.
build/
dist/
installer_output/

# Python
__pycache__/
*.pyc
.pytest_cache/

# server/ (license webhook service) — real secrets and the local ledger of
# issued keys/customer emails never belong in the repo.
server/.env
server/licenses.db

# Claude Code session-local files, not project source.
.claude/
