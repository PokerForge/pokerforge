# Copy this file to .env locally, or set these as real environment
# variables on whatever host runs this service (Render/Railway/Fly.io).
# Never commit an actual .env with real values.

# From the Stripe Dashboard -> Developers -> API keys. Required by both
# webhook_server.py (to look up subscription details) and
# setup_stripe_products.py (to create the Product/Prices/Payment Links).
# Use a sk_test_... key while building/testing, sk_live_... once real.
STRIPE_SECRET_KEY=sk_test_...

# Only used client-side (e.g. if you ever build a custom checkout page
# instead of the Payment Links setup_stripe_products.py creates). Safe to
# leave blank if you're just using Payment Links.
STRIPE_PUBLISHABLE_KEY=pk_test_...

# From the Stripe Dashboard -> Developers -> Webhooks -> your endpoint ->
# "Signing secret". Required -- requests without a valid signature are
# rejected outright.
STRIPE_WEBHOOK_SECRET=whsec_...

# From SendGrid -> Settings -> API Keys. If unset, the server still issues
# and records the key but skips sending the email (useful for testing the
# webhook wiring itself before email is configured).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=licenses@yourdomain.com

# Where the SQLite ledger of issued keys lives. Defaults to licenses.db
# next to webhook_server.py if unset.
LICENSE_LEDGER_PATH=

# The Ed25519 private key that signs licences, base64-encoded, as printed
# by scripts/generate_signing_key.py. Required -- without it the server
# cannot issue a licence at all. Its public counterpart is hardcoded in
# core/licensing.py and ships in the app; only this half is secret, and
# rotating it invalidates every licence already issued.
LICENSE_SIGNING_KEY=
